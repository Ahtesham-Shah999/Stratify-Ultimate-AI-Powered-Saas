{
  "name": "stratify",
  "version": "1.0.0",
  "description": "Stratify – AI-Powered Trading Strategy SaaS",
  "private": true,
  "scripts": {
    "test:api": "jest --config jest.config.js --forceExit",
    "test:api:coverage": "jest --config jest.config.js --forceExit --coverage --json --outputFile=tests/reports/jest-results.json",
    "test:api:json": "jest --config jest.config.js --forceExit --json --outputFile=tests/reports/jest-results.json",
    "test:ui": "playwright test --config playwright.config.js",
    "test:ui:headed": "cross-env HEADED=true playwright test --config playwright.config.js",
    "test:report": "node tests/scripts/generateReport.js",
    "test:full": "npm run test:api:json && npm run test:ui && npm run test:report"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "cross-env": "^7.0.3",
    "html-docx-js": "^0.3.1",
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.7",
    "jwt-decode": "^4.0.0",
    "marked": "^18.0.5",
    "mongoose": "^9.7.0",
    "nock": "^14.0.15",
    "supertest": "^7.2.2"
  }
}
